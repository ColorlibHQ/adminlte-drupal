{#
/**
 * @file
 * AdminLTE 4 implementation of the main (sidebar) menu.
 *
 * Renders the "Main navigation" menu as an AdminLTE treeview sidebar menu.
 * Place the "Main navigation" block in the Sidebar region to use it.
 *
 * Available variables:
 * - items: A nested list of menu items, each with: attributes, title, url,
 *   is_expanded, is_collapsed, in_active_trail, below (child items).
 * - menu_name: The machine name of the menu.
 *
 * @see template_preprocess_menu()
 */
#}
{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <nav class="mt-2" aria-label="{{ 'Main navigation'|t }}">
        <ul{{ attributes.addClass('nav', 'sidebar-menu', 'flex-column').setAttribute('role', 'navigation') }}>
    {% else %}
      <ul class="nav nav-treeview">
    {% endif %}
    {% for item in items %}
      {%
        set li_classes = [
          'nav-item',
          item.below ? 'menu-can-expand',
          item.in_active_trail ? 'menu-open',
        ]
      %}
      {%
        set link_classes = [
          'nav-link',
          item.in_active_trail ? 'active',
        ]
      %}
      <li{{ item.attributes.addClass(li_classes) }}>
        <a href="{{ item.url }}" class="{{ link_classes|join(' ')|trim }}">
          <i class="nav-icon bi {{ menu_level == 0 ? 'bi-record-circle' : 'bi-circle' }}" aria-hidden="true"></i>
          <p>{{ item.title }}</p>
        </a>
        {% if item.below %}
          {# Separate toggle so the link navigates and the chevron expands. #}
          <button type="button" class="nav-treeview-toggle" aria-expanded="{{ item.in_active_trail ? 'true' : 'false' }}" aria-label="{{ 'Toggle submenu'|t }}">
            <i class="nav-arrow bi bi-chevron-right" aria-hidden="true"></i>
          </button>
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
    {% if menu_level == 0 %}
      </nav>
    {% endif %}
  {% endif %}
{% endmacro %}
