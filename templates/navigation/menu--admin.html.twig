{#
/**
 * @file
 * AdminLTE 4 implementation of the Administration menu (sidebar treeview).
 *
 * Renders Drupal's "Administration" menu (Content, Structure, Appearance, …) as
 * an AdminLTE collapsible sidebar menu. Place the "Administration" menu block in
 * the Sidebar region to use it (shipped by default in this theme).
 *
 * Mirrors menu--main.html.twig; kept as a separate template so the two sidebar
 * menus can diverge (e.g. different icons) without affecting each other.
 *
 * Variables from adminlte_preprocess_menu():
 * - nav_icon_top_level: Bootstrap Icons class for top-level items (empty = none).
 * - nav_icon_sub_level: Bootstrap Icons class for nested items (empty = none).
 *
 * @see template_preprocess_menu()
 * @see adminlte_preprocess_menu()
 * @see adminlte_preprocess_menu__admin()
 */
#}
{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0, nav_icon_top_level, nav_icon_sub_level) }}

{% macro menu_links(items, attributes, menu_level, nav_icon_top_level, nav_icon_sub_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <nav class="mt-2" aria-label="{{ 'Administration'|t }}">
        <ul{{ attributes.addClass('nav', 'sidebar-menu', 'flex-column').setAttribute('role', 'navigation') }}>
    {% else %}
      <ul class="nav nav-treeview">
    {% endif %}
    {% for item in items %}
      {%
        set li_classes = [
          'nav-item',
          item.below ? 'menu-can-expand',
          item.in_active_trail ? 'menu-open',
        ]
      %}
      {%
        set link_classes = [
          'nav-link',
          item.in_active_trail ? 'active',
        ]
      %}
      <li{{ item.attributes.addClass(li_classes) }}>
        <a href="{{ item.url }}" class="{{ link_classes|join(' ')|trim }}">
          {% set icon_class = item.icon|default(menu_level == 0 ? nav_icon_top_level : nav_icon_sub_level) %}
          {% if icon_class %}
            <i class="nav-icon bi {{ icon_class }}" aria-hidden="true"></i>
          {% endif %}
          <p>{{ item.title }}</p>
        </a>
        {% if item.below %}
          {# Separate toggle so the link navigates and the chevron expands. #}
          <button type="button" class="nav-treeview-toggle" aria-expanded="{{ item.in_active_trail ? 'true' : 'false' }}" aria-label="{{ 'Toggle submenu'|t }}">
            <i class="nav-arrow bi bi-chevron-right" aria-hidden="true"></i>
          </button>
          {{ menus.menu_links(item.below, attributes, menu_level + 1, nav_icon_top_level, nav_icon_sub_level) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
    {% if menu_level == 0 %}
      </nav>
    {% endif %}
  {% endif %}
{% endmacro %}
