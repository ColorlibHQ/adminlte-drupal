{#
/**
 * @file
 * AdminLTE 4 implementation of the Administration menu (sidebar treeview).
 *
 * Renders Drupal's "Administration" menu (Content, Structure, Appearance, …) as
 * an AdminLTE collapsible sidebar menu. Place the "Administration" menu block in
 * the Sidebar region to use it (shipped by default in this theme).
 *
 * Mirrors menu--main.html.twig; kept as a separate template so the two sidebar
 * menus can diverge (e.g. different icons) without affecting each other.
 *
 * @see template_preprocess_menu()
 * @see adminlte_preprocess_menu__admin()
 */
#}
{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <nav class="mt-2" aria-label="{{ 'Administration'|t }}">
        <ul{{ attributes.addClass('nav', 'sidebar-menu', 'flex-column').setAttribute('data-lte-toggle', 'treeview').setAttribute('data-accordion', 'false').setAttribute('role', 'navigation') }}>
    {% else %}
      <ul class="nav nav-treeview">
    {% endif %}
    {% for item in items %}
      {%
        set li_classes = [
          'nav-item',
          item.below ? 'menu-can-expand',
          item.in_active_trail ? 'menu-open',
        ]
      %}
      {%
        set link_classes = [
          'nav-link',
          item.in_active_trail ? 'active',
        ]
      %}
      <li{{ item.attributes.addClass(li_classes) }}>
        <a href="{{ item.url }}" class="{{ link_classes|join(' ')|trim }}">
          <i class="nav-icon bi {{ item.icon|default(menu_level == 0 ? 'bi-record-circle' : 'bi-circle') }}" aria-hidden="true"></i>
          <p>
            {{ item.title }}
            {% if item.below %}
              <i class="nav-arrow bi bi-chevron-right" aria-hidden="true"></i>
            {% endif %}
          </p>
        </a>
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
    {% if menu_level == 0 %}
      </nav>
    {% endif %}
  {% endif %}
{% endmacro %}
